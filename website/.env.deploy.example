# Copy to .env.deploy and edit. Dotenv data, not shell commands.
# Environment variables override these values. ~/.ssh/config is not read.
SSH_HOST='your-vps.example.com'
SSH_PORT=22
SSH_USER='user'
# Use forward slashes on Windows, e.g. C:/Users/you/.ssh/id_ed25519.
SSH_PRIVATE_KEY='~/.ssh/id_ed25519'
# Optional encrypted-key passphrase or password authentication.
# SSH_PASSPHRASE='...'
# SSH_PASSWORD='...'
# Obtain the server host-key fingerprint through a trusted administrator/channel.
SSH_HOST_FINGERPRINT='SHA256:replace-with-server-host-key-fingerprint'
# Existing, writable directory dedicated to this site. Remote extras are deleted.
DEPLOY_PATH='/var/www/explorer'
# Public origin used for sharing and social metadata. No trailing path.
VITE_SITE_URL='https://explorer.example.com'
